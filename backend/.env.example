# CareerLens AI Environment Configuration
# Add your Groq API key here (get one free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq Model to use (default: llama-3.3-70b-versatile, or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: MongoDB connection string (if not provided, in-memory storage is used)
MONGO_URI=mongodb://localhost:27017/careerlens_ai

# Use production for deployed non-Lambda environments. Lambda is detected automatically.
# Production mode fails closed if MongoDB is unavailable; local development retains memory fallback.
APP_ENV=development

# Optional: GitHub Personal Access Token to increase rate limits (60 req/hr -> 5000 req/hr)
GITHUB_TOKEN=

# AWS SDK uses the standard credential chain (local profile/environment or Lambda execution role).
AWS_REGION=ap-southeast-2
S3_RESUME_BUCKET=careerlens-ai-resumes-unique-suffix

# Comma-separated browser origins allowed by the API. Production must set the verified CloudFront origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Set to the verified evaluation queue URL for the API Lambda; leave empty for local use.
EVALUATION_QUEUE_URL=

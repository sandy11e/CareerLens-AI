# CareerLens AI Environment Configuration
# Add your Groq API key here (get one free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq Model to use (default: llama-3.3-70b-versatile, or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: MongoDB connection string (if not provided, in-memory storage is used)
MONGO_URI=mongodb://localhost:27017/careerlens_ai

# Optional: GitHub Personal Access Token to increase rate limits (60 req/hr -> 5000 req/hr)
GITHUB_TOKEN=
